###############################################
# cloud-devbox 环境变量模板
###############################################

# 基本配置，默认区域：东京
GCP_PROJECT_ID=
GCP_REGION=asia-northeast1
GCP_ZONE=asia-northeast1-a

# 网络与安全
ADDRESS_NAME=dev-ip
FIREWALL_RULE_NAME=allow-ssh
# ⚠ 安全提醒: 0.0.0.0/0 允许任何 IP 访问 SSH，建议限制为你的 IP (如 1.2.3.4/32)
SOURCE_RANGES_SSH=0.0.0.0/0
NETWORK_TAGS=ssh,http

# 永久数据盘（挂载到 /workspace），默认 20G，后续可以修改
DISK_NAME=dev-data
DISK_SIZE_GB=20
DISK_TYPE=pd-balanced

# 持久系统盘（默认开启，apt install 的软件在实例重建后保留）
PERSIST_BOOT_DISK=true
BOOT_DISK_NAME=dev-boot
BOOT_DISK_SIZE_GB=20
BOOT_DISK_TYPE=pd-balanced

# 自定义镜像（可选）
# 如果配置了自定义镜像，脚本会先检测是否存在
# 如果不存在或未配置，则自动使用默认镜像
IMAGE_FAMILY=dev-gold
IMAGE_PROJECT=

# 默认镜像配置（当自定义镜像不可用时使用）
# 默认使用 Ubuntu 24.04 LTS
DEFAULT_IMAGE_FAMILY=ubuntu-2404-lts-amd64
DEFAULT_IMAGE_PROJECT=ubuntu-os-cloud

# 机器类型与实例命名
SPOT_INSTANCE_NAME=my-dev-machine
SPOT_MACHINE_TYPE=e2-standard-4
MAX_RUN_DURATION=4h
TERMINATION_ACTION=DELETE

# 构建镜像：默认 ubuntu 24.04 LTS
BUILDER_INSTANCE_NAME=dev-builder
BUILDER_MACHINE_TYPE=e2-standard-4
BASE_IMAGE_FAMILY=ubuntu-2404-lts-amd64
BASE_IMAGE_PROJECT=ubuntu-os-cloud

# Builder 可选配置（通过 metadata 传入 builder-setup.sh）
# 留空的项会在执行 builder-setup.sh 时交互询问
# BUILDER_REGION=overseas
# BUILDER_PROXY=http://host:port
# BUILDER_REPO_URL=https://github.com/William-Sang/cloud-devbox.git
# BUILDER_GIT_NAME=your-name
# BUILDER_GIT_EMAIL=your@email.com

# 挂载配置
MOUNT_POINT=/workspace
# 默认使用 /dev/disk/by-id/google-<DISK_NAME> 稳定路径，不受设备顺序影响
# 如需自定义，取消注释下面一行（不推荐使用 /dev/sdb 等顺序路径）
# MOUNT_DEVICE=/dev/disk/by-id/google-dev-data

# 标签用于批量销毁
LABEL_KEY=devbox
LABEL_VALUE=yes

# 可选：为实例指定服务账号（留空使用默认）
SERVICE_ACCOUNT_EMAIL=

# SSH 配置（可选，用于直接 SSH 登录）
# 如果配置了 SSH 公钥，会自动添加到实例的 metadata 中
# 推荐使用项目目录下的 ssh/ 目录存储密钥（已在 .gitignore 中排除）
# 生成密钥：bash scripts/setup-ssh-key.sh
# 或手动：ssh-keygen -t ed25519 -f ./ssh/gcp_dev -C "dev"
SSH_USERNAME=dev
SSH_PUBLIC_KEY_FILE=./ssh/gcp_dev.pub
